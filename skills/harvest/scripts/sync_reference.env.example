# Copy to .env (or export in your shell) before running sync_reference.
# All three Atlassian vars are required. Without them the script exits early.

KNOWLEDGE_MCP_ATLASSIAN_SITE=curve-analytics.atlassian.net
KNOWLEDGE_MCP_ATLASSIAN_EMAIL=you@example.com
KNOWLEDGE_MCP_ATLASSIAN_TOKEN=your-api-token-here

# Vault root (normally already set for knowledge-mcp itself).
KNOWLEDGE_MCP_VAULT_PATH=C:/Users/IsseiKuzuki/Knowledge Base/knowledge-vault
